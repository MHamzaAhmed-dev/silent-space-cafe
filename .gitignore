# Silent Space Café — Git Ignore

# Virtual environment
venv/
env/
.venv/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyc
.Python

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Environment variables
.env
.env.local
.env.production
.env.*
!.env.example
*.sqlite3
*.sqlite3-*
*.pem
*.key

# Generated screenshots, email captures and local logs stay on this computer.
artifacts/*
!artifacts/launch-handoff.txt
!artifacts/launch-production.json
!artifacts/launch-hardened-check.json
!artifacts/checkout-acceptance.json
!artifacts/reservation-checks.json
!artifacts/acceptance-results.json

# Retired personal design references are not runtime assets.
design-references/

# Static collected files
staticfiles/
static_collected/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Node (not used, but just in case)
node_modules/
