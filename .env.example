DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-secret
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_BASE_URL=http://127.0.0.1:8000
STAFF_NOTIFICATION_RECIPIENTS=owner@example.test,manager@example.test
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=cafe@example.test
EMAIL_HOST=smtp.example.test
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
ORDER_REMINDER_MINUTES=10
RESERVATION_REMINDER_MINUTES=60
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_SECONDS=60
MEDIA_URL=/media/
# Optional persistent upload location; defaults to the project's media folder.
# MEDIA_ROOT=D:/SilentSpaceMedia

# Optional Stripe-hosted Visa/Mastercard checkout; leave blank until merchant setup.
# Secrets belong only in environment/.env, never in Admin or source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set True only on a host with HTTPS configured; keep False for local HTTP.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=
